# Copy to `.env.local` for local dev (see quickstart.md).
# Values come from Supabase project settings → Database → connection strings.

# Postgres (Prisma): prefer pooler/session mode URI with ssl where required by host.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Optional: direct (non-pooler) URI for prisma migrate when the pooler disallows DDL.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase Auth & API — client-safe keys:
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_public_key"

# Server-only — never expose in client bundles or frontend env.
SUPABASE_SERVICE_ROLE_KEY="your_service_role_secret"
